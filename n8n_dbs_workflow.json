            { "id": "f2", "name": "Type",           "value": "={{ $json.type }}",      "type": "string" },
            { "id": "f3", "name": "Amount (SGD)",   "value": "={{ $json.amount }}",    "type": "number" },
            { "id": "f4", "name": "From",           "value": "={{ $json.from }}",      "type": "string" },
            { "id": "f5", "name": "To",             "value": "={{ $json.to }}",        "type": "string" },
            { "id": "f6", "name": "A/C Ending",     "value": "={{ $json.acEnding }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
