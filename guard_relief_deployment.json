      "id": "relief-read-pool-001",
      "name": "Read Relief Guards",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-1140, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "fkooqHE06zipBeCm",
