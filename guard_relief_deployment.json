    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1HwTGYiIQrMLNyMVlhi_BppsodOa6xZwZNqC5pnuMfUg",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Guards",
          "mode": "name"
        },
        "options": {}
      },
      "id": "relief-read-att-001",
      "name": "Read Attendance Today",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-920, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "fkooqHE06zipBeCm",
          "name": "Google Sheets OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const site        = $('Extract Relief Info').item.json.site;\nconst date        = $('Extract Relief Info').item.json.date;\nconst adminChatId = $('Extract Relief Info').item.json.admin_chat_id;\n\n// All relief guards from pool\nconst reliefPool = $('Read Relief Guards').all();\n\n// Guards already deployed today (in attendance sheet)\nconst attendanceRows = $input.all();\nconst deployedToday = attendanceRows\n  .filter(r => String(r.json['Date'] || '').trim() === date)\n  .map(r => String(r.json['Telegram_ID'] || '').trim());\n\n// Find first available relief guard not deployed today\nconst available = reliefPool.find(r => {\n  const tid   = String(r.json['Telegram_ID'] || '').trim();\n  const avail = String(r.json['Availability'] || '').toLowerCase();\n  return tid !== '' && avail === 'available' && !deployedToday.includes(tid);\n});\n\nif (!available) {\n  return [{\n    json: {\n      found: false,\n      site,\n      date,\n      admin_chat_id: adminChatId\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    telegram_id:  String(available.json['Telegram_ID']).trim(),\n    guard_name:   available.json['Guard Name']  || 'Relief Guard',\n    phone:        available.json['Phone']        || 'N/A',\n    site,\n    date,\n    admin_chat_id: adminChatId\n  }\n}];"
      },
      "id": "relief-find-001",
      "name": "Find Available Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-700, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            {
              "id": "relief-avail-001",
              "leftValue": "={{ $json.found }}",
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "relief-check-001",
      "name": "Guard Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "=🚨 *Urgent Relief Deployment*\n\n👤 *Guard:* {{ $json.guard_name }}\n📍 *Site:* {{ $json.site }}\n📅 *Date:* {{ $json.date }}\n\nA permanent guard is on urgent leave\\. You have been assigned as relief\\. Please proceed to your assigned site and share your *live location* upon arrival to record attendance\\. 🛡️",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "relief-notify-guard-001",
      "name": "Notify Relief Guard",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-260, -160],
      "credentials": {
        "telegramApi": {
          "id": "tU4R9SEuNlBNrZWs",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.admin_chat_id }}",
        "text": "=✅ *Relief Guard Assigned*\n\n📍 *Site:* {{ $json.site }}\n📅 *Date:* {{ $json.date }}\n👤 *Relief Guard:* {{ $json.guard_name }}\n📞 *Phone:* {{ $json.phone }}\n\nThe guard has been notified via Telegram\\.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "relief-notify-admin-001",
      "name": "Notify Admin: Assigned",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-260, 0],
      "credentials": {
        "telegramApi": {
          "id": "tU4R9SEuNlBNrZWs",
          "name": "Telegram account"
        }
      }
    },
    {
