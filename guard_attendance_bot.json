      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet type = 'unknown';\nlet chatId = '';\nlet telegramId = '';\nlet callbackData = '';\nlet userName = '';\n\nif (item.callback_query) {\n  type = 'callback_query';\n  callbackData = item.callback_query.data || '';\n  chatId = String(item.callback_query.message.chat.id);\n  telegramId = String(item.callback_query.from.id);\n  userName = (item.callback_query.from.first_name || '') + ' ' + (item.callback_query.from.last_name || '');\n} else if (item.message) {\n  type = 'message';\n  chatId = String(item.message.chat.id);\n  telegramId = String(item.message.from.id);\n  userName = (item.message.from.first_name || '') + ' ' + (item.message.from.last_name || '');\n  callbackData = item.message.text || '';\n}\n\nreturn [{ json: { ...item, detected_type: type, chat_id: chatId, telegram_id: telegramId, callback_data: callbackData, user_name: userName.trim() } }];"
      },
