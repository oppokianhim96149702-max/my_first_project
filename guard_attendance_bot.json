    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst now = new Date();\nconst sg = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Singapore' }));\nconst h = sg.getHours();\nconst shift = (h >= 7 && h < 19) ? 'Day Shift (7AM-7PM)' : 'Night Shift (7PM-7AM)';\nconst isLate = (shift.includes('Day') && h >= 8) || (shift.includes('Night') && (h >= 20 || h < 7));\nconst sgTime = sg.toLocaleString('en-SG', { timeZone: 'Asia/Singapore' });\nconst chatId = $('Detect Type').item.json.chat_id;\n\n// Return reply_markup as a plain OBJECT (not JSON string).\n// The Telegram node expression will stringify it with JSON.stringify().\nconst reply_markup = {\n  inline_keyboard: [[\n    { text: '\\u2705 Check In', callback_data: 'action_checkin' },\n    { text: '\\uD83D\\uDEAA Check Out', callback_data: 'action_checkout' }\n  ]]\n};\n\nreturn [{ json: { ...item, chat_id: chatId, current_shift: shift, is_late: isLate, sg_time: sgTime, reply_markup } }];"
      },
