    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst data = item.callback_data || '';\n\nif (!data.startsWith('action_') && !data.startsWith('checkin_') && !data.startsWith('checkout_')) {\n  return [{ json: { ...item, route: 'unknown' } }];\n}\n\nconst now = new Date();\nconst sg = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Singapore' }));\nconst h = sg.getHours();\nconst shift = (h >= 7 && h < 19) ? 'Day Shift' : 'Night Shift';\nconst isLate = (shift === 'Day Shift' && h >= 8) || (shift === 'Night Shift' && (h >= 20 || h < 7));\nconst status = isLate ? 'Late' : 'On Time';\nconst sgTime = sg.toLocaleString('en-SG', { timeZone: 'Asia/Singapore' });\nconst chatId = $('Detect Type').item.json.chat_id;\n\nlet route = '';\nlet action = '';\nlet site = '';\n// Return reply_markup as a plain OBJECT — Telegram node will stringify it.\nlet reply_markup = null;\n\nif (data === 'action_checkin') {\n  route = 'show_sites';\n  action = 'Check In';\n  const sites = (item['Assigned Sites'] || 'S01').split(',').map(s => s.trim());\n  reply_markup = { inline_keyboard: sites.map(s => [{ text: '\\uD83D\\uDCCD ' + s, callback_data: 'checkin_' + s }]) };\n} else if (data === 'action_checkout') {\n  route = 'show_sites';\n  action = 'Check Out';\n  const sites = (item['Assigned Sites'] || 'S01').split(',').map(s => s.trim());\n  reply_markup = { inline_keyboard: sites.map(s => [{ text: '\\uD83D\\uDCCD ' + s, callback_data: 'checkout_' + s }]) };\n} else if (data.startsWith('checkin_')) {\n  route = 'log';\n  action = 'Check In';\n  site = data.replace('checkin_', '');\n} else if (data.startsWith('checkout_')) {\n  route = 'log';\n  action = 'Check Out';\n  site = data.replace('checkout_', '');\n}\n\nreturn [{ json: { ...item, chat_id: chatId, route, action, site, current_shift: shift, is_late: isLate, status, sg_time: sgTime, reply_markup } }];"
      },
