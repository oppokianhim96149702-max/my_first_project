    {
      "parameters": {
        "jsCode": "const telegramId = String($('Extract Attendance Data').item.json.telegram_id);\nconst rows = $input.all();\nconst match = rows.find(row => String(row.json['Telegram ID']) === telegramId);\n\nreturn [{\n  json: {\n    found: !!match,\n    assigned_site: match ? (match.json['Assigned Site'] || 'Unassigned') : 'Unassigned',\n    site_lat:  match ? (parseFloat(match.json['Site Lat'])  || null) : null,\n    site_lng:  match ? (parseFloat(match.json['Site Lng'])  || null) : null\n  }\n}];"
      },
