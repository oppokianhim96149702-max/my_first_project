      "id": "334bc7b5-f0f6-4d4c-a11d-c9d25425ca19",
      "name": "Merge Attendance + Site",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -752,
        128
      ]
