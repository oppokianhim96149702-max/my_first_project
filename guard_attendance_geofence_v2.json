    {
      "parameters": {
        "jsCode": "const guardLat = Number($('Merge Attendance + Site').item.json.guard_lat);\nconst guardLng = Number($('Merge Attendance + Site').item.json.guard_lng);\nconst siteLat  = Number($('Merge Attendance + Site').item.json.site_lat);\nconst siteLng  = Number($('Merge Attendance + Site').item.json.site_lng);\n\n// No site coordinates in master sheet — skip geofence, allow check-in\nif (!siteLat || !siteLng) {\n  return [{ json: { within_geofence: true, distance_meters: 0 } }];\n}\n\nconst R = 6371000; // Earth radius in metres\nconst dLat = (siteLat - guardLat) * Math.PI / 180;\nconst dLng = (siteLng - guardLng) * Math.PI / 180;\nconst a = Math.sin(dLat / 2) ** 2 +\n          Math.cos(guardLat * Math.PI / 180) *\n          Math.cos(siteLat  * Math.PI / 180) *\n          Math.sin(dLng / 2) ** 2;\nconst distance = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n\nreturn [{ json: {\n  within_geofence: distance <= 100,\n  distance_meters: Math.round(distance)\n} }];"
      },
