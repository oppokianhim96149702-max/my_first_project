            { "id": "merge-002", "name": "telegram_username","value": "={{ $('Extract Attendance Data').item.json.telegram_username }}", "type": "string" },
            { "id": "merge-003", "name": "telegram_id",      "value": "={{ String($('Extract Attendance Data').item.json.telegram_id) }}", "type": "string" },
            { "id": "merge-004", "name": "message_text",     "value": "={{ $('Extract Attendance Data').item.json.message_text }}", "type": "string" },
            { "id": "merge-005", "name": "date",             "value": "={{ $('Extract Attendance Data').item.json.date }}", "type": "string" },
