    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const telegramId = String($('Merge Attendance + Site').item.json.telegram_id);\nconst today = $('Merge Attendance + Site').item.json.date;\nconst rows = $input.all();\n\nif (rows.length === 0) {\n  return [{ json: { duplicate: false } }];\n}\n\nconst duplicate = rows.some(row =>\n  String(row.json['Telegram_ID'] || '') === telegramId &&\n  String(row.json['Date'] || '') === today\n);\n\nreturn [{ json: { duplicate } }];"
      },
