            { "id": "merge-010", "name": "guard_lng",        "value": "={{ $('Extract Attendance Data').item.json.guard_lng }}", "type": "number" },
            { "id": "merge-011", "name": "site_lat",         "value": "={{ $json.site_lat }}", "type": "number" },
