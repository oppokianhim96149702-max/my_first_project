    {
      "parameters": {
        "jsCode": "// Cast both sides to string to avoid number vs text mismatch in the sheet\nconst telegramId = String($('Extract Attendance Data').item.json.telegram_id);\nconst rows = $input.all();\n\nconst match = rows.find(row => String(row.json['Telegram ID']) === telegramId);\n\n// Always returns exactly 1 item — workflow never silently stops here\nreturn [{\n  json: {\n    found: !!match,\n    assigned_site: match ? (match.json['Assigned Site'] || 'Unassigned') : 'Unassigned'\n  }\n}];"
      },
